# Base PostgreSQL locale / CI.
# En production sur Netlify : inutile, Netlify Database injecte NETLIFY_DB_URL automatiquement.
DATABASE_URL="postgresql://adjuge:adjuge@localhost:5432/adjuge"
# Secret NextAuth : openssl rand -base64 32
AUTH_SECRET=
# Derrière le proxy Netlify
AUTH_TRUST_HOST=true
# Qualification assistée par Claude (côté serveur uniquement) — nom exact : ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=
# Facultatif : modèle Claude (par défaut claude-sonnet-5, choix de la spécification)
ADJUGE_MODELE_CLAUDE=
# E-mails transactionnels
RESEND_API_KEY=
# Paiement en ligne marocain (vague 1+)
CMI_MERCHANT_ID=
# Protection des fonctions planifiées Netlify
CRON_SECRET=
